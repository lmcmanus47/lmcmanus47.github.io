geom_point(data = output1, mapping= aes(x = t, y = SM), color = "yellow")+
geom_point(data = output1, mapping= aes(x = t, y = SN), color = "green")+
geom_point(data = output1, mapping= aes(x = t, y = EM), color = "blue")+
